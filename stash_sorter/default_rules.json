{
  "version": 1,
  "_help": "Categories are checked top to bottom; an item goes to the first category whose 'match' fits. 'match' is one condition set or a list of alternatives (any may match). Conditions: types / not_types (item type codes, e.g. amul, ring, char, jewl, weap, armo, rune, gem), codes / not_codes (base item codes), quality / not_quality (inferior normal superior magic set rare unique crafted tempered), runeword, ethereal, socketed, carry_one (true/false), tier (normal exceptional elite), min_ilvl, max_ilvl, as_is (keep maybe none), assess_tier (Top Good OK Low), name_contains. 'sort' orders items on a mule: size, ilvl, name, set, slot. 'share_with' lists categories whose mules may take overflow. 'stackable' marks categories that can go into the RotW Stackables tab.",
  "valuable_mods": ["ama", "sor", "nec", "pal", "bar", "dru", "ass", "war", "skilltab", "allskills", "cast1", "cast2",
                    "cast3", "balance1", "balance2", "balance3", "move1", "move2", "move3", "res-all", "hp", "mana",
                    "mag%", "lifesteal", "manasteal", "dmg%", "att", "dmg-max", "dmg-min", "red-dmg", "ac%"],
  "categories": [
    {"key": "runes", "label": "Runes", "stem": "Runes", "stackable": true,
     "match": {"types": ["rune"]}},
    {"key": "gems", "label": "Gems", "stem": "Gems", "stackable": true,
     "match": {"types": ["gem"]}},
    {"key": "mats", "label": "Keys, essences, organs, tokens & materials", "stem": "Mats", "stackable": true,
     "match": [{"types": ["ques"], "not_codes": ["box"]}, {"codes": ["key"]}]},
    {"key": "jewelry", "label": "Rings & amulets", "stem": "Jewelry", "sort": "name",
     "match": [{"types": ["amul", "ring"], "not_quality": ["magic"]},
               {"types": ["amul", "ring"], "quality": ["magic"], "as_is": ["keep"]}]},
    {"key": "craftbait", "label": "Craft bait (magic rings & amulets)", "stem": "CraftBait", "sort": "ilvl",
     "share_with": ["jewelry"],
     "match": {"types": ["amul", "ring"], "quality": ["magic"]}},
    {"key": "unicharms", "label": "Unique charms (Anni / Torch / Gheed / Sunder)", "stem": "UniCharms",
     "share_with": ["charms", "uniques"],
     "match": {"types": ["char"], "carry_one": true}},
    {"key": "junkcharms", "label": "Junk charms (low ilvl, nothing worth keeping)", "stem": "JunkCharms",
     "match": {"types": ["char"], "quality": ["magic"], "assess_tier": ["Low"], "as_is": ["none"]}},
    {"key": "charms", "label": "Charms", "stem": "Charms", "sort": "size",
     "match": {"types": ["char"]}},
    {"key": "jewels", "label": "Jewels", "stem": "Jewels", "sort": "name",
     "match": {"types": ["jewl"]}},
    {"key": "runewords", "label": "Runewords", "stem": "Runewords", "sort": "name",
     "match": {"runeword": true}},
    {"key": "uniques", "label": "Unique gear", "stem": "Uniques", "sort": "slot",
     "match": {"types": ["weap", "armo"], "quality": ["unique"]}},
    {"key": "sets", "label": "Set items", "stem": "Sets", "sort": "set",
     "match": {"types": ["weap", "armo"], "quality": ["set"]}},
    {"key": "rares", "label": "Rare & crafted gear", "stem": "Rares", "sort": "slot",
     "match": {"types": ["weap", "armo"], "quality": ["rare", "crafted", "tempered"]}},
    {"key": "ethbases", "label": "Ethereal bases", "stem": "EthBases", "sort": "slot", "share_with": ["bases"],
     "match": {"types": ["weap", "armo"], "quality": ["inferior", "normal", "superior"], "ethereal": true}},
    {"key": "bases", "label": "Runeword bases (white / grey)", "stem": "Bases", "sort": "slot",
     "match": {"types": ["weap", "armo"], "quality": ["inferior", "normal", "superior"]}},
    {"key": "magicgear", "label": "Magic gear", "stem": "MagicGear", "sort": "slot",
     "match": {"types": ["weap", "armo"], "quality": ["magic"]}},
    {"key": "misc", "label": "Everything else", "stem": "Misc",
     "match": {}}
  ]
}
